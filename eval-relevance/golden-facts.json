  {
    "question": "How much solar power did Belgium produce on 21 June 2026?",
    "tool": "electricity_grid",
    "args": {
      "date": "2026-06-21"
    },
    "expect": [
      {
        "path": "solar.gwh",
        "between": [
          55,
          75
        ]
      },
      {
        "path": "solar.peak_mw",
        "between": [
          6500,
          8500
        ]
      },
      {
        "path": "generation_mix.by_fuel.0.fuel",
        "equals": "solar"
      }
    ],
    "source": "https://opendata.elia.be/explore/dataset/ods032/",
    "why": "Elia measured about 64 GWh of solar on 21 June 2026, peaking near 7.6 GW, the largest source in Belgian generation that day."
  },
  {
    "question": "What does the desk say about electricity in Belgium on 1 March 2021 (consumption, and the generation mix, or that Elia does not keep it)?",
    "tool": "electricity_grid",
    "args": {
      "date": "2021-03-01"
    },
    "expect": [
      {
        "path": "load.gwh",
        "between": [
          220,
          270
        ]
      },
      {
        "any": [
          [
            {
              "path": "generation_mix.total_gwh",
              "between": [
                250,
                320
              ]
            }
          ],
          [
            {
              "path": "generation_mix_unavailable.dataset_starts",
              "matches": "^20\\d\\d-\\d\\d-\\d\\d$"
            }
          ]
        ]
      }
    ],
    "source": "https://opendata.elia.be/explore/dataset/ods201/",
    "why": "Consumption that day was about 244 GWh. Elia changes what its generation-by-fuel dataset (ods201) keeps: on the morning of 2026-11-18 it started on 2026-08-22, an hour later it held 2021 again (286.5 GWh generated, consistent with 244.5 GWh load plus 38.7 GWh net export). Either answer is right; leaving the mix out silently is not."
  },
