  {
    "question": "How punctual is the commute from Leuven to Brussels-Central?",
    "tool": "train_punctuality",
    "args": {
      "from_station": "Leuven",
      "to_station": "Bruxelles-Central"
    },
    "expect": [
      {
        "path": "mode",
        "equals": "journey"
      },
      {
        "path": "journey.from",
        "equals": "Leuven"
      },
      {
        "path": "journey.to",
        "equals": "Brussel-Centraal"
      },
      {
        "path": "outbound.trains",
        "between": [
          30,
          250
        ]
      },
      {
        "path": "outbound.scheduled_minutes_fastest",
        "between": [
          15,
          35
        ]
      }
    ],
    "source": "https://opendata.infrabel.be/explore/dataset/ruwe-gegevens-van-stiptheid-d-1/",
