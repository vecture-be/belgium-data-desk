[
  {
    "question": "How many people lived in Belgium on 1 January 2026?",
    "tool": "belgian_statistics",
    "args": {
      "places": [
        "Belgium"
      ],
      "topic": "population"
    },
    "expect": [
      {
        "path": "places.0.pop.reference_date",
        "equals": "2026-01-01"
      },
      {
        "path": "places.0.pop.population",
        "equals": 11867634
      }
    ],
    "source": "https://statbel.fgov.be/en/themes/population/structure-population",
    "why": "The headline Statbel figure; a change means the tables were rebuilt wrongly or Statbel revised it."
  },
  {
    "question": "How many tax declarations were there in Belgium for income year 2023?",
    "tool": "belgian_statistics",
    "args": {
      "places": [
        "Belgium"
      ],
      "topic": "income"
    },
    "expect": [
      {
        "path": "places.0.income.income_year",
        "equals": 2023
      },
      {
        "path": "places.0.income.declarations",
        "equals": 6846186
      }
    ],
    "source": "https://statbel.fgov.be/en/themes/households/taxable-income",
    "why": "Statbel fiscal statistics; a new income year changes this on purpose, so update it with the source."
  },
  {
    "question": "Population of Melle (merged into Merelbeke-Melle on 1 January 2025)",
