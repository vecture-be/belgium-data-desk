    },
    "expect": [
      {
        "path": "results.0.authoritative_source",
        "equals": true
      },
      {
        "path": "results.0.publisher",
        "matches": "Statbel"
      }
    ],
    "source": "https://statbel.fgov.be/en/open-data",
    "why": "The authoritative source must stay first for the most common question."
  },
  {
