      {
        "path": "highest_class",
        "equals": "A"
      },
      {
        "path": "place.nis_code",
        "equals": "24062"
      }
    ],
    "source": "https://www.waterinfo.be/informatieplicht",
    "why": "VMM's maps class this point A; a change means new maps or a broken lookup."
  },
  {
    "question": "Which source is official for population by municipality?",
    "tool": "search_datasets",
    "args": {
      "query": "bevolking per gemeente",
